{
  "name": "session-dashboard",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Real-time session monitoring dashboard for Claude Code and Codex CLI",
  "bin": {
    "session-dashboard": "lib/cli.js"
  },
  "files": [
    "lib/",
    "dist/",
    "hooks/"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vue-tsc -b && vite build",
    "build:server": "node build-server.mjs",
    "prepublishOnly": "npm run build",
    "preview": "vite preview",
    "setup:hooks": "tsx scripts/setup-hooks.ts",
    "setup:codex": "tsx scripts/setup-codex.ts",
    "insights": "tsx scripts/read-insights.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "express": "^5.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-vue": "^5.2.0",
    "concurrently": "^9.1.0",
    "dompurify": "^3.3.3",
    "esbuild": "^0.25.12",
    "marked": "^17.0.4",
    "pinia": "^3.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.0"
  }
}
